#!/usr/bin/env python3
"""修正 Wine 的反斜杠 file URI，再交给已有桌面默认处理器。"""
import os
import sys
from urllib.parse import quote, unquote


def normalize(value):
    if not value.startswith("file://"):
        return value
    tail = value[7:]
    # 仅修正现场观察到的反斜杠格式，不改合法 URI 的远程主机名。
    if "\\" not in tail:
        return value
    path = tail.replace("\\", "/")
    path = "/" + path.lstrip("/")
    return "file://" + quote(unquote(path), safe="/")


def main():
    if len(sys.argv) != 2:
        raise SystemExit("用法：xdg-open <文件或 URI>")
    value = normalize(sys.argv[1])
    # -- 避免路径被 GIO 解释为命令选项。
    os.execvp("gio", ["gio", "open", "--", value])


if __name__ == "__main__":
    main()
