 static XimInstCallback	callback_list	= NULL;
 static Bool		lock		= False;
 
+/* A process can use several independent Display connections.  Each one
+ * needs its own root-window filter while it has instantiate callbacks. */
+static Bool
+HasCallbacksForDisplay(Display *display)
+{
+    XimInstCallback icb;
+
+    for (icb = callback_list; icb; icb = icb->next)
+        if (icb->display == display && !icb->destroy)
+            return True;
+    return False;
+}
